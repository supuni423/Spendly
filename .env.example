# Copy the relevant values into extension/.env and backend/.env as needed.
# This file just documents what exists across the whole project.

# backend/.env
DATABASE_URL=postgresql+psycopg://spendly:spendly@localhost:5432/spendly
JWT_SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# A deployed backend must also include the extension's real origin here —
# chrome-extension://<extension-id>, visible in chrome://extensions once
# loaded — since a Manifest V3 extension has no other stable origin to allow.
CORS_ORIGINS=["http://localhost:5173"]
LLM_PROVIDER=gemini
LLM_API_KEY=
